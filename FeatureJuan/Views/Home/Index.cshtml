@model IEnumerable<Equipe>
@{
    ViewData["Title"] = "Home Page";
}

<div>
    <div class="uk-flex uk-flex-center" style="gap:10px;">
        <span>FootOne</span>
        <span>|</span>
        <span>Buscar times</span>
    </div>
    <hr class="">
    <div class="uk-flex uk-flex-center">
        <div class="container-teams">
            <div class="info uk-margin-top">
                <span class="uk-text-bold uk-margin-left">Informações do time</span>
            </div>
            <hr>
            <div class="uk-flex uk-flex-column" style="gap: 46px;">
                <div class="uk-flex uk-flex-center" style="gap: 10px;">
                    <input id="Nome" class="uk-input uk-form-width-medium uk-form-small" type="text" placeholder="Time"
                        aria-label="Small">
                    <input id="QuantidadeIntegrantes" class="uk-input uk-form-width-medium uk-form-small" type="text"
                        placeholder="Quantidade de integrantes" aria-label="Small">
                    <select id="divisao" class="uk-select uk-form-width-medium uk-form-small" aria-label="Select">
                        <option disabled selected>Divisão Atual</option>
                        @if (ViewBag.Divisoes != null)
                        {
                            foreach (var divisao in ViewBag.Divisoes)
                            {
                                <option>@divisao.Nome</option>
                            }
                        }
                    </select>
                </div>
                <div class="uk-flex uk-flex-right uk-margin-large-right " style="gap: 10px;">
                    <a href='@Url.Action("CadastrarTime", "Home")'>
                        <button class=" padrao-botao uk-button-small">+ ADICIONAR TIME</button>
                    </a>
                    <button id="buscarTime" class="padrao-botao uk-button-small">BUSCAR</button>
                </div>
            </div>
            <table class="padrao-tabela uk-table uk-table-small uk-table-divider">
                <thead>
                    <tr>
                        <th class="uk-text-center">Time</th>
                        <th class="uk-text-center">Qtd. Integrantes</th>
                        <th class="uk-text-center">Divisão Atual</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model != null && @Model.Any())
                    {
                        foreach (var equipe in @Model)
                        {
                            <tr class="uk-text-center buscarEquipe">
                                <td id="NomeTimeTd">@equipe.Nome</td>
                                <td id="QuantidadeIntegrantesTd">@equipe.QuantidadeIntegrantes</td>
                                <td id="DivisaoTd">@equipe.Divisao.Nome</td>
                                <td>
                                    <a class="botao-editar"
                                        href="@Url.Action("EditarTime", "Home", new { EquipeId = equipe.EquipeId })">
                                        Editar
                                    </a>
                                </td>
                                <td>
                                    <a class="botao-excluir" href="#modal-sections-@equipe.EquipeId" uk-toggle>Excluir</a>
                                    <div id="modal-sections-@equipe.EquipeId" uk-modal>
                                        <div class="uk-modal-dialog  uk-margin-auto-vertical">
                                            <button class="uk-modal-close-default" type="button" uk-close></button>
                                            <div class="uk-modal-header uk-padding-small" style="height: 44px;">
                                                <h2 class="uk-modal-title uk-text-center">Excluir</h2>
                                            </div>
                                            <div class="uk-modal-body uk-flex uk-flex-column uk-text-center uk-padding-small">
                                                <span>Você irá excluir permanentemente o TIME:</span>
                                                <span class="padrao-nome-time uk-text-bold">@equipe.Nome</span>
                                                <span>Deseja Continuar?</span>
                                            </div>
                                            <div class="uk-text-right uk-text-center uk-padding-small uk-flex uk-flex-center"
                                                style="gap: 10px;">
                                                <button class="uk-button uk-button-default uk-modal-close"
                                                    type="button">NÃO</button>
                                                <button class="uk-button uk-button-primary confirmar-exclusao"
                                                    data-id="@equipe.EquipeId" type="button">SIM</button>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('.confirmar-exclusao').click(function () {
            var botaoClicado = $(this);
            var id = $(this).data('id');
            var linha = $(this).closest('tr');

            $.post('@Url.Action("DeletarTime", "Home")', {
                EquipeId: id
            }).done(function () {
                linha.remove();
                UIkit.modal(botaoClicado.closest('[uk-modal]')).hide();
                window.location.reload();
            }).fail(function () {
                alert('Erro ao excluir time!');
            });
        });
    });
    $(document).ready(function () {
        $("#buscarTime").click(function () {
            const nomeInput = $('#Nome').val().trim().toLowerCase();
            const quantidadeInput = $('#QuantidadeIntegrantes').val().trim().toLowerCase();
            const divisaoInput = $('#divisao').val()?.trim().toLowerCase() || '';

            if (nomeInput === "" && quantidadeInput === "" && divisaoInput === "") {
                $('.buscarEquipe').show(); 
                return;
            }

            $('.buscarEquipe').each(function () {
                const tr = $(this);

                const nomeTd = tr.find('#NomeTimeTd').text().trim().toLowerCase();
                const quantidadeTd = tr.find('#QuantidadeIntegrantesTd').text().trim().toLowerCase();
                const divisaoTd = tr.find('#DivisaoTd').text().trim().toLowerCase();

                const matchesNome = nomeInput !== "" && nomeTd.includes(nomeInput);
                const matchesQuantidade = quantidadeInput !== "" && quantidadeTd.includes(quantidadeInput);
                const matchesDivisao = divisaoInput !== "" && divisaoTd.includes(divisaoInput);

                if (matchesNome || matchesQuantidade || matchesDivisao) {
                    tr.show();
                } else {
                    tr.hide();
                }
            });
        });
    });
</script>